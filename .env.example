# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored so your password never leaves your machine.

# --- PostgreSQL connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maridive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# SQLAlchemy builds the connection string from the parts above, e.g.:
# postgresql+psycopg2://postgres:your_password_here@localhost:5432/maridive
